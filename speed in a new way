from math import sqrt

def tension(tension1, tension2):
    #for tensionControlUnit
    dTension=tension2-tension1
    tension=tension2
    return(dTension, tension)

def frequency(frequency1, frequency2):
    #for frequencyControlUnit
    dFrequency=frequency2-frequency1
    frequency=frequency2
    return(dFrequency, frequency)

def mass(mass1, mass2):
    #for massControlUnit
    dMass=mass2-mass1
    mass=mass2
    return(dMass, mass)

def impedance(impedance1, impedance2):
    #for impedanceControlUnit
    dImpedance=impedance2-impedance1
    impedance=impedance2
    return(dImpedance, impedance)

def speed(tension, frequency, mass, impedance):
    #for speedControlUnit
    V=tension
    f=frequency
    m=mass
    Z=impedance
    if(V==0 or f==0 or m==0 or Z==0):
        pass
    else:
        ν_M=V/sqrt(f*m*Z)
        ν=ν_M/sqrt(2)
        return(ν_M, ν, V, f, m, Z)

def deltaSpeed(dTension, dFrequency, dMass, dImpedance):
    #for speedControlUnit
    if(dTension==0 or dFrequency==0 or dMass==0 or dImpedance==0):
        pass
    else:
        dV=dTension
        df=dFrequency
        dm=dMass
        dZ=dImpedance
        dν=dV/sqrt(df*dm*dZ)
        return(dν)

def speedDivergence(V, f, m, Z):
    #for nominalSpeedControlUnit
    if(V==0 or f==0 or m==0 or Z==0):
        pass
    else:
        pdV=1/sqrt(f*m*Z)
        pdf=-V/(2*f*sqrt(f*m*Z))
        pdm=-V/(2*m*sqrt(f*m*Z))
        pdZ=-V/(2*Z*sqrt(f*m*Z))
        divergenceν=pdV+pdf+pdm+pdZ
        return(divergenceν)

def tensionDivergence(ν, f, m, Z):
    #for nominalTensionControlUnit
    if(ν==0 or f==0 or m==0 or Z==0):
        pass
    else:
        pdν=sqrt(f*m*Z)
        pdf=(ν*sqrt(m*Z))/(2*sqrt(f))
        pdm=(ν*sqrt(f*Z))/(2*sqrt(m))
        pdZ=(ν*sqrt(f*m))/(2*sqrt(Z))
        divergenceV=pdν+pdf+pdm+pdZ
        return(divergenceV)

def frequencyDivergence(ν, V, m, Z):
    #for nominalFrequencyControlUnit
    if(ν==0 or V==0 or m==0 or Z==0):
        pass
    else:
        pdV=(2*V)/(m*Z*ν**2)
        pdm=-(V**2)/(m**2*Z*ν**2)
        pdZ=-(V**2)/(m*Z**2*ν**2)
        gdν=-(2*V**2)/(m*Z*ν**3)
        divergencef=pdV+pdm+pdZ+gdν
        return(divergencef)

def massDivergence(ν, V, f, Z):
    #for nominalMassControlUnit
    if(ν==0 or V==0 or f==0 or Z==0):
        pass
    else:
        pdV=(2*V)/(f*Z*ν**2)
        pdf=-(V**2)/(f**2*Z*ν**2)
        pdZ=-(V**2)/(f*Z**2*ν**2)
        gdν=-(2*V**2)/(f*Z*ν**3)
        divergencem=pdV+pdf+pdZ+gdν
        return(divergencem)

def impedanceDivergence(ν, V, f, m):
    #for nominalImpedanceControlUnit
    if(ν==0 or V==0 or f==0 or m==0):
        pass
    else:
        pdV=(2*V)/(f*m*ν**2)
        pdf=-(V**2)/(f**2*m*ν**2)
        pdm=-(V**2)/(f*m**2*ν**2)
        gdν=-(2*V**2)/(f*m*ν**3)
        divergenceZ=pdV+pdm+pdf+gdν
        return(divergenceZ)
