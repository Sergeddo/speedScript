from math import sqrt

class Wave():
    def tension(tension1, tension2):
        #for tensionControlUnit
        dTension=tension2-tension1
        tension=tension2
        return(dTension, tension)

    def frequency(frequency1, frequency2):
        #for frequencyControlUnit
        dFrequency=frequency2-frequency1
        frequency=frequency2
        return(dFrequency, frequency)

    def mass(mass1, mass2):
        #for massControlUnit
        dMass=mass2-mass1
        mass=mass2
        return(dMass, mass)

    def impedance(impedance1, impedance2):
        #for impedanceControlUnit
        dImpedance=impedance2-impedance1
        impedance=impedance2
        return(dImpedance, impedance)

    def speed(tension, frequency, mass, impedance):
        #for speedControlUnit
        V=tension
        f=frequency
        m=mass
        Z=impedance
        if(V==0 or f==0 or m==0 or Z==0):
            pass
        else:
            w_M=V/sqrt(f*m*Z)
            w=w_M/sqrt(2)
            return(w_M, w, V, f, m, Z)

    def deltaSpeed(dTension, dFrequency, dMass, dImpedance):
        #for speedControlUnit
        if(dTension==0 or dFrequency==0 or dMass==0 or dImpedance==0):
            pass
        else:
            dV=dTension
            df=dFrequency
            dm=dMass
            dZ=dImpedance
            dw=dV/sqrt(df*dm*dZ)
            return(dw)

    def speedDivergence(V, f, m, Z):
        #for nominalSpeedControlUnit
        if(V==0 or f==0 or m==0 or Z==0):
            pass
        else:
            pdV=1/sqrt(f*m*Z)
            pdf=-V/(2*f*sqrt(f*m*Z))
            pdm=-V/(2*m*sqrt(f*m*Z))
            pdZ=-V/(2*Z*sqrt(f*m*Z))
            divergencew=pdV+pdf+pdm+pdZ
            return(divergencew)

    def tensionDivergence(w, f, m, Z):
        #for nominalTensionControlUnit
        if(w==0 or f==0 or m==0 or Z==0):
            pass
        else:
            pdw=sqrt(f*m*Z)
            pdf=(w*sqrt(m*Z))/(2*sqrt(f))
            pdm=(w*sqrt(f*Z))/(2*sqrt(m))
            pdZ=(w*sqrt(f*m))/(2*sqrt(Z))
            divergenceV=pdw+pdf+pdm+pdZ
            return(divergenceV)

    def frequencyDivergence(w, V, m, Z):
        #for nominalFrequencyControlUnit
        if(w==0 or V==0 or m==0 or Z==0):
            pass
        else:
            pdV=(2*V)/(m*Z*w**2)
            pdm=-(V**2)/(m**2*Z*w**2)
            pdZ=-(V**2)/(m*Z**2*w**2)
            pdw=-(2*V**2)/(m*Z*w**3)
            divergencef=pdV+pdm+pdZ+pdw
            return(divergencef)

    def massDivergence(w, V, f, Z):
        #for nominalMassControlUnit
        if(w==0 or V==0 or f==0 or Z==0):
            pass
        else:
            pdV=(2*V)/(f*Z*w**2)
            pdf=-(V**2)/(f**2*Z*w**2)
            pdZ=-(V**2)/(f*Z**2*w**2)
            pdw=-(2*V**2)/(f*Z*w**3)
            divergencem=pdV+pdf+pdZ+pdw
            return(divergencem)

    def impedanceDivergence(w, V, f, m):
        #for nominalImpedanceControlUnit
        if(w==0 or V==0 or f==0 or m==0):
            pass
        else:
            pdV=(2*V)/(f*m*w**2)
            pdf=-(V**2)/(f**2*m*w**2)
            pdm=-(V**2)/(f*m**2*w**2)
            pdw=-(2*V**2)/(f*m*w**3)
            divergenceZ=pdV+pdm+pdf+pdw
            return(divergenceZ)
